<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>planar_arm_control</name>
  <version>0.1.0</version>
  <description>
    Kineshia Robotics take-home: ROS 2 control + telemetry GUI for a 3-DoF
    planar manipulator. Candidate implements the controller and GUI nodes;
    the kinematics library (planar_arm.py) is provided.
  </description>
  <maintainer email="hr@kineshia.in">Kineshia Robotics</maintainer>
  <license>Proprietary — for evaluation use only</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- PyQt5 and pyqtgraph are pip/apt dependencies; see README. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
